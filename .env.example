# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 git에 올라가지 않습니다)

# Supabase → Project Settings → Database → Connection string → "Session pooler" URI
# 비워 두면 로컬 내장 PostgreSQL(.pgdata/)을 자동으로 띄워 사용합니다.
DATABASE_URL=

# DeepSeek API 키 (https://platform.deepseek.com/api_keys). 비워 두면 LLM 없이 템플릿 리포트로 발송합니다.
DEEPSEEK_API_KEY=

# Slack Incoming Webhook URL. 비워 두면 이메일 → 콘솔 출력 순으로 대체합니다.
SLACK_WEBHOOK_URL=

# (선택) Slack 실패 시 이메일 fallback
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=

# Mock API 주소 (기본값 그대로 두면 됩니다)
MOCK_API_BASE_URL=http://127.0.0.1:8000
